<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<HBox xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cab302.cab302.controller.NavController"
      spacing="0"
      style="-fx-padding: 10; -fx-background-color: #2b2b2b;">

    <!-- Left navigation buttons -->
    <HBox fx:id="links1" alignment="CENTER_LEFT" spacing="20">
        <Button fx:id="homeButton" text="Home"
                style="-fx-text-fill: white; -fx-background-color: transparent; -fx-font-size: 12;" />
        <Button fx:id="leaderboardButton" text="Leaderboard"
                style="-fx-text-fill: white; -fx-background-color: transparent; -fx-font-size: 12;" />
        <Button fx:id="aboutButton" text="About"
                prefWidth="65.0"
                style="-fx-text-fill: white; -fx-background-color: transparent; -fx-font-size: 12;" />
    </HBox>

    <Region HBox.hgrow="ALWAYS" />

    <!-- Center title -->
    <StackPane alignment="CENTER">
        <Label text="Mental Math Game"
               style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;" />
    </StackPane>

    <Region HBox.hgrow="ALWAYS" />

    <!-- Right-side buttons -->
    <HBox fx:id="links2" alignment="CENTER_RIGHT" spacing="20">
        <Button fx:id="profileButton"
                prefHeight="25.0" prefWidth="169.0"
                style="-fx-text-fill: white; -fx-background-color: transparent; -fx-font-size: 12;"
                text="Profile" />
    </HBox>
</HBox>