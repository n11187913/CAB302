<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.web.*?>

<BorderPane prefHeight="720" prefWidth="1080" style="-fx-background-color: #3c3c3c;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cab302.cab302.controller.QuestionController">

    <!-- Center Question and Answer Section -->
    <center>
        <VBox alignment="CENTER" spacing="20">

            <!-- Score and High Score -->
            <HBox alignment="CENTER" spacing="40">
                <Label fx:id="scoreLabel" style="-fx-text-fill: #3c3c3c; -fx-font-size: 16;" text="Score: 0" />
                <Label fx:id="highScoreLabel" style="-fx-text-fill: #3c3c3c; -fx-font-size: 16;" text="High Score: 0" />
                <Label fx:id="fastestAnswerLabel" style="-fx-text-fill: #3c3c3c; -fx-font-size: 16;" text="Top Speed: 0" />
                <Label fx:id="streakLabel" style="-fx-text-fill: #3c3c3c; -fx-font-size: 16;" text="Streak: 0" />
            </HBox>

            <VBox alignment="CENTER" spacing="6" prefWidth="750">
                <HBox alignment="CENTER" spacing="8" prefWidth="750">
                    <Label fx:id="timerLabel" style="-fx-text-fill: #cccccc; -fx-font-size: 16;" text="Time: 1:30" />
                </HBox>

                <Label fx:id="questionCounterLabel" style="-fx-text-fill: #cccccc; -fx-font-size: 16;" text="" />
            </VBox>

            <!-- Timer Progress Bar -->
            <ProgressBar fx:id="progressBar" prefWidth="750" progress="0.3" style="-fx-accent: #2DBEDF;" />

            <!-- Question Display -->
            <!-- LaTeX Question Display -->
            <Label fx:id="questionType" style="-fx-text-fill: #cccccc; -fx-font-size: 16;" />
            <WebView fx:id="questionWebView" prefHeight="60.0" prefWidth="905.0" />

            <!-- Answer Input -->
            <TextField fx:id="answerField" maxWidth="200" promptText="Enter your answer..." style="-fx-border-color: white; -fx-border-radius: 2%; -fx-border-width: 1; -fx-background-color: #2b2b2b; -fx-text-fill: white; -fx-font-size: 16;" />
            <Button fx:id="submit" mnemonicParsing="false" onAction="#checkAnswer" style="-fx-background-color: #2DBEDF; -fx-text-fill: white; -fx-font-size: 16;" text="Submit" textFill="WHITE" />
            <Button fx:id="goHome" mnemonicParsing="false" onAction="#onLeave" style="-fx-background-color: #2DBEDF; -fx-text-fill: white; -fx-font-size: 16;" text="Go Home" textFill="WHITE" visible="false" />
            <Label fx:id="statusLabel" textAlignment="CENTER" textFill="RED">
                <font>
                    <Font size="14.0" />
                </font>
            </Label>

            <Button fx:id="skipButton" onAction="#onSkip" prefHeight="0.0" prefWidth="46.0" style="-fx-background-color: red; -fx-text-fill: white; -fx-font-size: 14;" text="Skip" />
        </VBox>
    </center>

    <!-- Bottom Skip Button -->
    <bottom>

    </bottom>

</BorderPane>
